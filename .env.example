# ---- Configurações de ambiente para o projeto Astra AI (exemplo) ---
# ---- Identificação do grupo ----
RM=rmXXXXXX                     # RM do grupo (prefixo de ACR/ACI/imagens)
RESOURCE_GROUP=rg-astra-hub
LOCATION=canadacentral

# ---- ACR (Azure Container Registry) ----
ACR_NAME=astrahub${RM}
ACR_SKU=Standard

# ---- Nomes das imagens ----
ORACLE_IMAGE_NAME=oracle-astra-${RM}
JAVA_IMAGE_NAME=java-api-astra-${RM}
IMAGE_TAG=v1

# ---- Storage Account (volume do Oracle) ----
STORAGE_ACCOUNT_NAME=volumeastradata${RM}
FILE_SHARE_NAME=oracle-astra-volume

# ---- Key Vault ----
KEY_VAULT_NAME=keyvault-${RM}

# ---- Segredos do banco / aplicação ----
ORACLE_ROOT_PASSWORD=troque-esta-senha
ORACLE_DATABASE=NOME_DO_BANCO
APP_USER=rmYYYYYY
APP_PASSWORD=troque-esta-senha

# ---- Datasource (Spring) ----
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//oracledb:1521/NOME_DO_BANCO
SPRING_DATASOURCE_USERNAME=rmYYYYYY
SPRING_DATASOURCE_PASSWORD=troque-esta-senha
SPRING_DATASOURCE_DRIVER_CLASS_NAME=oracle.jdbc.OracleDriver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.OracleDialect
CONNECTIONSTRINGS=Server=oracledb;Port=1521;Database=NOME_DO_BANCO;User=rmYYYYYY;Password=troque-esta-senha;

# ---- APIs externas ----
API_CLIMA_URL=https://api.openweathermap.org
API_CLIMA_KEY=sua-api-key-aqui
API_DOTNET_URL=http://localhost:5000

# ---- Config extra da aplicação ----
SPRING_APPLICATION_NAME=astraai
SERVER_PORT=8080
SPRING_CLOUD_OPENFEIGN_CLIENT_CONFIG_DEFAULT_CONNECTTIMEOUT=3000
SPRING_CLOUD_OPENFEIGN_CLIENT_CONFIG_DEFAULT_READTIMEOUT=3000
SPRINGDOC_ENABLE_HATEOAS=false

# ---- Nomes dos containers (ACI) ----
ACI_ORACLE_NAME=oracle-astra-aci-${RM}
ACI_JAVA_NAME=java-api-astra-aci-${RM}
ACI_ORACLE_DNS_LABEL=oracle-astra-container-${RM}
ACI_JAVA_DNS_LABEL=api-java-container-${RM}
